# Copy to .env and change what you need. Every value has a working default for a local `docker compose up`.

# Where the competition datasets live on the host (General Data/, Training Data/, Test Data/).
DATA_DIR=./data

# Ports on the host
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Database and message broker credentials
POSTGRES_USER=routelanka
POSTGRES_PASSWORD=routelanka
POSTGRES_DB=routelanka
RABBITMQ_USER=routelanka
RABBITMQ_PASSWORD=routelanka

# Password for the four seeded demo accounts
SEED_PASSWORD=routelanka
# Set to 1 once to rebuild all data from the datasets (wipes demo days)
SEED_FORCE=0

# Secrets. The defaults are for local use only; a public deployment must set long random values
# (e.g. `openssl rand -hex 32`) and ALLOW_DEV_SECRETS=false, or the API refuses to start.
SESSION_SECRET=dev-only-secret-change-me-in-production-please
SMS_GATEWAY_TOKEN=dev-sms-token
ALLOW_DEV_SECRETS=true

# Set to true behind HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false

# WhatsApp Business Platform (docs/whatsapp.md). "simulator" uses the bundled Cloud API simulator (/wa-sim);
# "cloud" sends through Meta: set the API base, phone number id, token, app secret and verify token from your Meta app,
# and list the real numbers that may be messaged (a Meta test number reaches up to 5 verified numbers).
WHATSAPP_MODE=simulator
WHATSAPP_API_BASE=http://wa-sim:3200
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_TOKEN=dev-wa-token
WHATSAPP_APP_SECRET=dev-wa-app-secret
WHATSAPP_VERIFY_TOKEN=dev-wa-verify-token
WHATSAPP_LIVE_NUMBERS=
# Public address of the web app (links in messages, and the webhook URL to give Meta)
PUBLIC_URL=http://localhost:3000
WA_SIM_PORT=3200
